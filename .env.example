# === 推荐：Cursor Agent 当游戏居民 ===
CURSOR_API_KEY=
AI_CIV_CURSOR_MODEL=composer-2.5
# 单文明一次 Cursor 调用的最大毫秒数（默认 120000=2 分钟）
# AI_CIV_CURSOR_TIMEOUT_MS=120000
# Optional: extra ms on top of (timeout × 2 civs) for the browser POST /advance wait
# AI_CIV_ADVANCE_POST_BUFFER_MS=30000
# cursor | handoff | openai-hybrid | mock（mock 仅测试）
# 默认不配 Key 时自动=practice（可直接玩）；有 Key 可设 cursor
AI_CIV_AGENT_MODE=practice

# === 备用：OpenAI 兼容 ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_CIV_LLM_MODEL=gpt-4o-mini

HOST=127.0.0.1
PORT=3001
